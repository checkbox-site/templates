# Copy to .env.local and fill in. Never commit .env.local.

# Stripe test-mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (local) or the webhook endpoint you add in Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this app (no trailing slash). On Vercel it defaults to the production URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Acme
SUPPORT_EMAIL=support@example.com

# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
SESSION_SECRET=
# Protects /api/cron/reminders (Vercel Cron sends it automatically as a bearer token).
CRON_SECRET=

# Optional: send email with Resend. Without it, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=Acme <billing@example.com>

# Optional: Checkbox (free to start). Records consents, binds them to subscriptions, supplies the reminder schedule and
# runs `npm run checkbox:preflight`. Get keys at https://app.checkbox.site/sign-up or let your coding agent connect it.
CHECKBOX_SECRET_KEY=
NEXT_PUBLIC_CHECKBOX_PUBLISHABLE_KEY=
