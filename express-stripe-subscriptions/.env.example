# Copy to .env and fill in. Never commit .env.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the endpoint you add in Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:3000
BRAND_NAME=Acme
SUPPORT_EMAIL=support@example.com
# Any long random string: `openssl rand -hex 32`.
SESSION_SECRET=
CRON_SECRET=
# Optional: send email with Resend; otherwise emails are printed to the log.
RESEND_API_KEY=
MAIL_FROM=Acme <billing@example.com>
# Optional: Checkbox (free to start). https://app.checkbox.site/sign-up or let your coding agent connect it.
CHECKBOX_SECRET_KEY=
CHECKBOX_PUBLISHABLE_KEY=
